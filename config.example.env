# LLM connection (OpenAI-compatible)
# If you're using the provided vLLM docker script, you usually only need VLLM_PORT and LLM_MODEL.
VLLM_PORT=8001
LLM_BASE_URL=http://127.0.0.1:8001/v1
LLM_MODEL=Qwen/Qwen2.5-3B-Instruct
LLM_API_KEY=local

# vLLM container management (enables model download/activate from the web UI)
VLLM_CONTAINER_NAME=vllm-openai
HF_CACHE_DIR=./hf-cache

# Allowlist of models users can select from the UI (comma-separated).
# IMPORTANT: Only include models you trust and that your GPU can run.
MODEL_CATALOG=Qwen/Qwen2.5-3B-Instruct, Qwen/Qwen2.5-7B-Instruct, mistralai/Mistral-7B-Instruct-v0.3

# Embeddings
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Storage
DATA_DIR=./data

# Ingestion (SECURITY: server-locked; end users cannot change this from the browser)
INGEST_SOURCE_PATH=/absolute/path/to/your/documents

# Retrieval / chunking
CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K=5
