# LLM connection (OpenAI-compatible)
# If you're using the provided vLLM docker script, you usually only need VLLM_PORT and LLM_MODEL.
VLLM_PORT=8001
LLM_BASE_URL=http://127.0.0.1:8001/v1
LLM_MODEL=Qwen/Qwen2.5-3B-Instruct
LLM_API_KEY=local

# vLLM container management (enables model download/activate from the web UI)
VLLM_CONTAINER_NAME=vllm-openai
HF_CACHE_DIR=./hf-cache

# Hugging Face token (optional; required for gated/private models)
# DO NOT commit your real token. Put it in your local `.env` / server secrets.
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model switch safety: wait for GPU memory to clear after stopping the previous model
VLLM_SWITCH_WAIT_FOR_GPU_MEM_BELOW_MIB=1500
VLLM_SWITCH_WAIT_TIMEOUT_S=45

# vLLM memory tuning (useful on smaller GPUs)
VLLM_MAX_NUM_SEQS=1
VLLM_MAX_MODEL_LEN=2048
VLLM_GPU_MEMORY_UTILIZATION=0.95

# Allowlist of models users can select from the UI (comma-separated).
# IMPORTANT: Only include models you trust and that your GPU can run.
MODEL_CATALOG=Qwen/Qwen2.5-3B-Instruct, Qwen/Qwen2.5-7B-Instruct, mistralai/Mistral-7B-Instruct-v0.3, google/gemma-3-12b-it

# Web UI auth (HTTP Basic). Strongly recommended if the port is reachable by others.
APP_USERNAME=admin
APP_PASSWORD=

# Host interface for the managed vLLM container's published port (vLLM has no auth).
VLLM_BIND_HOST=127.0.0.1

# Embeddings
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Storage
DATA_DIR=./data

# Ingestion (SECURITY: server-locked; end users cannot change this from the browser)
INGEST_SOURCE_PATH=/absolute/path/to/your/documents

# Retrieval / chunking
CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K=5
